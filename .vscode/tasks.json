{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "DbMCP: build",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"DbMCP.slnx"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "DbMCP: run (project)",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"DbMCP/DbMCP.csproj"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"DBMCP_CONNECTION_STR": "Server=localhost;Database=McpData;Integrated Security=true;TrustServerCertificate=true;",
					"DBMCP_SCHEMA": "mcp"
				}
			},
			"isBackground": true
		},
		{
			"label": "DbMCP: run (built dll)",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"${workspaceFolder}/DbMCP/bin/Debug/net10.0/DbMCP.dll"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"DBMCP_CONNECTION_STR": "Server=localhost;Database=McpData;Integrated Security=true;TrustServerCertificate=true;",
					"DBMCP_SCHEMA": "mcp",
					"DBMCP_INSTANCE_NAME": "McpCRM.Prebuilt"
				}
			},
			"isBackground": true
		}
	]
}
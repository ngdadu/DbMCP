{
  "servers": {
    "dbmcp": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "DbMCP/DbMCP.csproj"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "DBMCP_CONNECTION_STR": "Server=localhost;Database=McpData;Integrated Security=true;TrustServerCertificate=true;",
        "DBMCP_SCHEMA": "mcp",        
        "DBMCP_HTTP": "false"
      }
    },
    "dbmcp-built": {
      "type": "http",
      "url": "http://localhost:5000/mcp"
    }
  }
}

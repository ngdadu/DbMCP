{
  "servers": {
    "dbmcp": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "DbMCP/DbMCP.csproj"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "DBMCP_CONNECTION_STR": "Server=localhost;Database=McpData;Integrated Security=true;TrustServerCertificate=true;",
        "DBMCP_SCHEMA": "mcp"
      }
    },
    "dbmcp-built": {
      "type": "stdio",
      "command": "${workspaceFolder}/DbMCP/bin/Debug/net10.0/DbMCP.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "DBMCP_CONNECTION_STR": "Server=localhost;Database=McpData;Integrated Security=true;TrustServerCertificate=true;",
        "DBMCP_SCHEMA": "mcp",
        "DBMCP_INSTANCE_NAME": "McpCRM.Prebuilt"
      }
    }
  }
}
